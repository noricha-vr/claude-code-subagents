<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <!-- Background -->
  <rect width="512" height="512" fill="#3b82f6" rx="50"/>
  
  <!-- Video icon -->
  <rect x="128" y="192" width="256" height="128" fill="#1f2937" rx="12"/>
  
  <!-- Play button -->
  <polygon points="200,220 200,300 280,260" fill="#ef4444"/>
  
  <!-- Sound waves -->
  <path d="M320 240 Q340 240 340 260 Q340 280 320 280" stroke="white" stroke-width="6" fill="none"/>
  <path d="M340 220 Q370 220 370 260 Q370 300 340 300" stroke="white" stroke-width="6" fill="none"/>
  <path d="M360 200 Q400 200 400 260 Q400 320 360 320" stroke="white" stroke-width="6" fill="none"/>
  
  <!-- Arrow pointing down -->
  <path d="M256 340 L240 360 L272 360 Z" fill="white"/>
  
  <!-- MP3 text -->
  <text x="256" y="420" text-anchor="middle" fill="white" font-family="Arial" font-size="48" font-weight="bold">MP3</text>
  
  <!-- App name -->
  <text x="256" y="480" text-anchor="middle" fill="white" font-family="Arial" font-size="24">Vid2MP3</text>
</svg>