{
  "name": "Video to MP3 Converter",
  "short_name": "Video2MP3",
  "description": "Convert video files to high-quality MP3 audio offline using FFmpeg.wasm",
  "version": "1.0.0",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#3b82f6",
  "background_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  
  "icons": [
    {
      "src": "/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Desktop view of the video converter"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Mobile view of the video converter"
    }
  ],
  
  "categories": ["productivity", "multimedia", "utilities"],
  "shortcuts": [
    {
      "name": "Convert Video",
      "short_name": "Convert",
      "description": "Start converting a video file",
      "url": "/?action=convert",
      "icons": [
        {
          "src": "/icon-96x96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/*": [
          ".mp4",
          ".avi",
          ".mov",
          ".mkv",
          ".webm",
          ".wmv",
          ".flv",
          ".3gp",
          ".ogv",
          ".m4v"
        ]
      }
    }
  ],
  
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": [
            "video/*"
          ]
        }
      ]
    }
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+video2mp3",
      "url": "/?video=%s"
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "related_applications": [],
  "prefer_related_applications": false,
  
  "iarc_rating_id": "",
  
  "permissions": [
    "storage"
  ],
  
  "features": [
    "offline-support",
    "file-conversion",
    "drag-drop",
    "batch-processing"
  ]
}