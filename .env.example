# Video to MP3 Converter - 環境変数設定例

# アプリケーション設定
VITE_APP_TITLE="Video to MP3 Converter"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="ブラウザ内で動画ファイルをMP3音声ファイルに変換するPWA"

# FFmpeg設定
VITE_FFMPEG_CORE_PATH="/ffmpeg-core"
VITE_FFMPEG_LOG_LEVEL="info"

# PWA設定
VITE_PWA_NAME="Video to MP3 Converter"
VITE_PWA_SHORT_NAME="Video2MP3"
VITE_PWA_THEME_COLOR="#3B82F6"
VITE_PWA_BACKGROUND_COLOR="#FFFFFF"

# 開発環境設定
VITE_DEV_MODE="false"
VITE_DEBUG_MODE="false"

# 外部サービス（使用する場合）
# VITE_ANALYTICS_ID=""
# VITE_ERROR_TRACKING_DSN=""

# セキュリティ設定
VITE_ENABLE_COOP="true"
VITE_ENABLE_COEP="true"

# パフォーマンス設定
VITE_MAX_FILE_SIZE_MB="1000"
VITE_WORKER_TIMEOUT_MS="300000"

# 本番環境追加設定（必要に応じて）
# VITE_CDN_URL=""
# VITE_API_URL=""