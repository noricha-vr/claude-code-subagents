{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '🔧 ツールを使用する前に、エージェントが適切に割り当てられていることを確認してください。'",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '📝 ユーザープロンプトが送信されました。タスクに応じてエージェントを適切に割り当ててください。'"
                    }
                ]
            }
        ]
    }
}
