{
    "hooks": {
        "userpromptsubmit": "/Users/main/project/claude-code-agents/.claude/scripts/agent-assignment.sh",
        "PreToolUse": [
            {
                "matcher": "Task\\(",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/Users/main/project/claude-code-agents/.claude/scripts/pre-task-check.sh",
                        "timeout": 5000
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Task\\(",
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo '✅ タスクが実行されました。エージェントが適切に割り当てられていることを確認してください。'",
                        "timeout": 2000
                    }
                ]
            }
        ]
    }
}
